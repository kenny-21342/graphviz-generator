# No API keys or native Graphviz installation are required.
# DOT generation runs in the browser; preview and auto-layout use Graphviz WASM.

# Optional per-instance abuse controls for the public render/layout endpoints.
# These reset on serverless cold starts and are not shared between instances.
# GRAPHVIZ_RATE_LIMIT_PER_MINUTE=20
# GRAPHVIZ_RATE_LIMIT_PER_HOUR=300
